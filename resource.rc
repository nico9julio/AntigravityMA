#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "AntigravityMA.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "AntigravityMA"
            VALUE "FileDescription",  "Antigravity Multi-Account & Profile Manager"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "AntigravityMA"
            VALUE "OriginalFilename", "AntigravityMA.exe"
            VALUE "ProductName",      "Antigravity Multi-Account (AntigravityMA)"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
